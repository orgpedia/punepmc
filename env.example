# Copy to .env and fill in. Never commit .env.
# On GitHub Actions the same names are set as repository secrets.

# Hugging Face token with write access to the dataset (https://huggingface.co/settings/tokens)
HF_TOKEN=
# Optional, defaults to Orgpedia/punePMC
HF_REPO_ID=

# archive.org S3 keys (https://archive.org/account/s3.php), used for uploads and Wayback SPN2
IA_ACCESS_KEY=
IA_SECRET_KEY=
